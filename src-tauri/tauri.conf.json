{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Happy Mixer DJ",
  "version": "0.1.0",
  "identifier": "com.happymixerdj.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Happy Mixer DJ",
        "width": 1600,
        "height": 980,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": []
  }
}
